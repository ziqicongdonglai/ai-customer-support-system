# Default reproducible/offline mode: mock | deepseek
LLM_PROVIDER=mock
REQUEST_TIMEOUT=60
MAX_CONTEXT_TOKENS=4000
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant.

# Required only when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Docker Compose backend database URL for the selected reviewer topology
DATABASE_URL=postgresql+asyncpg://ai_user:ai_password@postgres:5432/ai_chat

CORS_ORIGINS=http://localhost:3000

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_VECTOR_STORE_PATH=/app/vector_data
RAG_COLLECTION_NAME=business_knowledge
RAG_TOP_K=3

RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
